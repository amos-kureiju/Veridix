# =============================================================================
# VERIDIX — KONFIGURASI ENVIRONMENT (.env)
# =============================================================================

# --- 1. Database Connection ---
# Gunakan SQLite lokal secara default, atau ganti dengan PostgreSQL (Supabase / RDS)
DATABASE_URL=sqlite:///./hoax_inspect.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/veridix_db

# --- 2. Keamanan & Autentikasi JWT ---
JWT_SECRET_KEY=VERIDIX_POLITICAL_AI_SECRET_KEY_2026_SUPER_SECURE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# --- 3. Pengaturan AI & Ambang Batas Klasifikasi ---
DEFAULT_HOAX_THRESHOLD=0.60
MODEL_NAME_OR_PATH=indobenchmark/indobert-base-p1
SAVED_MODEL_PATH=saved_models/indobert_focal_loss/best_model.pt

# --- 4. Cross-Origin Resource Sharing (CORS) ---
# Alamat Frontend Next.js yang diizinkan mengakses API
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
