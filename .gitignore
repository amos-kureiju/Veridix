# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.log

# Caches and Virtual Environments
.env
.env.local
venv/
env/
ENV/

# Data & Uploads (Hanya lacak struktur folder via .gitkeep)
